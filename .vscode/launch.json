            "args": [],
            "stopAtEntry": true,
            "cwd": "${workspaceFolder}/project2/processes-shell",
            "environment": [],
            "console": "integratedTerminal",
            "MIMode": "gdb",
            "setupCommands": [
                {
                    "description": "Follow fork mode",
