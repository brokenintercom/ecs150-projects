{
    "version": "0.2.0",
    "configurations": [

        {
            "name": "Debug wcat",
            "type": "cppdbg",
            "request": "launch",
            "program": "${workspaceFolder}/project1/initial-utilities/wcat/wcat",
            "args": ["tests/6.in"],
            "stopAtEntry": false,
            "cwd": "${workspaceFolder}/project1/initial-utilities/wcat",
            "environment": [],
